precision mediump float;uniform vec2 u_resolution;uniform float u_time;void main(){vec2 p=(gl_FragCoord.xy-.5*u_resolution)/min(u_resolution.x,u_resolution.y);float r=length(p),a=atan(p.y,p.x)+u_time/12.,s=3.14159/6.;a=abs(mod(a,s)-s*.5);vec2 q=r*vec2(cos(a),sin(a));float b=sin(32.*q.x+9.*cos(18.*q.y-u_time));float d=abs(sin(40.*q.y-20.*r+u_time*.5));float v=1.-smoothstep(.12,.27,abs(b));vec3 c=mix(vec3(.01,.03,.1),vec3(.08,.8,.75),smoothstep(-.7,.9,b));gl_FragColor=vec4(c+vec3(1.,.5,.2)*v*(.4+.6*d),1.);}
